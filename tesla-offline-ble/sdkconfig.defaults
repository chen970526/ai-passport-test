# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"

# --- Flash / 分区（沿用 ai-passport 的 8MB + 单 factory 布局，便于 merge-bin 从 0x0 起刷）---
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台：USB-Serial-JTAG（C3 原生 USB，GPIO18/19）---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL（车钥匙最小界面，与 ai-passport 基线同口径）---
# 内置 malloc 池是独立静态区、不与系统堆共享；C3 无 PSRAM，24KB 是基线实证够用的值。
# 不配这两条 montserrat 时 LV_FONT_DEFAULT 会指空，主题初始化直接崩。
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_MEM_SIZE_KILOBYTES=24
# 配网引导页二维码（captive portal 不弹时的兜底入口，见 key_ui.c）
CONFIG_LV_USE_QRCODE=y

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth LE / NimBLE：本机作 central，车辆 VCSEC 是 peripheral ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
# 屏幕日志环形缓冲只有 8 格，NimBLE 每次扫描的 INFO 刷屏会把真正的
# 按键/协议报错挤掉；排障期降到 WARNING（错误/警告仍保留）。
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# --- Wi-Fi：只为「无 VIN 时的配网热点」而开（见 vin_cfg.c），内存压到最小 ---
# NimBLE+LVGL 已吃掉大半内部 RAM，默认缓冲会让 esp_wifi_init 直接 ESP_ERR_NO_MEM
# （实测报 alloc pm_beacon_offset fail）。配网页只传一个表单，小缓冲完全够。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
# C3 的 IRAM 和 DRAM 是同一块物理 RAM：这两个"提速"选项直接吃掉约 44KB+26KB 堆，
# 是 alloc pm_beacon_offset fail 的主因。热点只传一个表单页，不需要提速，关掉。
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set

# --- mbedTLS：P-256 ECDH（握手派生 K），其余 mbedTLS 选项沿用 IDF 默认，避免与 NimBLE 冲突 ---
CONFIG_MBEDTLS_ECP_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
